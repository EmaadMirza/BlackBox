flowchart TD
    classDef attackable stroke-dasharray: 5 5,stroke:#E4002B,fill:#131316,color:#F5F5F6
    classDef trusted stroke:#F5F5F6,fill:#131316,color:#F5F5F6
    classDef verifier stroke:#9A9AA0,fill:#131316,color:#F5F5F6
    classDef external fill:#131316,stroke:#26262C,color:#9A9AA0

    subgraph "Assumed Attackable Zone"
        C[Client / Agent SDK]:::attackable
        
        subgraph Gateway[GATEWAY "the guard and chaperone"]
            direction TB
            WL[Web Lane]
            AL[Agent Lane]
            
            P[Pipeline: Sanity -> Sig -> Rate Limit -> Rules -> Honeytokens -> Policy]
            
            B[Credential Broker]
            H[Approval Hold]
            L[Logger/Sealer]
            R[Responder]
            HB[Heartbeat Emitter]
            
            WL --> P
            AL --> P
            P --> B
            P --> H
            P --> L
            P --> R
            P --> HB
        end
        Gateway:::attackable
        
        Redis[(Redis Nonces)]:::attackable
        Origin[ORIGIN APP "demo shop"]:::attackable
        Ledger[(LEDGER "the diary")]:::attackable
    end

    subgraph "Trusted Zone"
        Witness[WITNESS "the notary"]:::trusted
        RootKey[Offline Root Key + 3-of-5 Holders]:::trusted
        Human[Human Approver]:::trusted
    end

    subgraph "Verifier Side"
        Reconciler[RECONCILER "bank statement check"]:::verifier
        Verifier[VERIFIER CLI]:::verifier
        Recovery[RECOVERY Toolkit]:::verifier
        Narrator[AI NARRATOR "summary, not evidence"]:::verifier
        Dashboard[DASHBOARD]:::verifier
    end

    Provider[PAYMENT PROVIDER "mock"]:::external

    C -->|Signs requests| Gateway
    Gateway -.->|Uses| Redis
    Gateway -->|Forwards (Locked)| Origin
    Gateway -->|Brokered Calls| Provider
    Gateway -->|Sealed Entries| Ledger
    Gateway -->|Heartbeats| Witness
    
    Ledger -->|Checkpoints| Witness
    
    Reconciler -.->|Matches events| Ledger
    Reconciler -.->|Fetches logs| Provider
    Reconciler -.->|Echoes| Origin
    
    Verifier -.->|Reads| Ledger
    Verifier -.->|Reads| Witness
    
    Recovery -.->|Reads| Verifier
    Narrator -.->|Reads Verified| Verifier
    Dashboard -.->|Reads| Verifier
    
    Human -.->|Approves| Gateway
    RootKey -.->|Certifies Epoch Keys| Gateway
